{
  "id": "netease.lite",
  "name": "网易云音乐 · 简洁版",
  "version": "1.3.0",
  "minAppVersion": "3.0.0",
  "main": "index.js",
  "icon": "icon.jpg",
  "playback": "stream",
  "permissions": {
    "network": [
      "interfacepc.music.163.com",
      "music.163.com"
    ]
  },
  "navigation": [
    {
      "title": "发现音乐",
      "page": "discover"
    },
    {
      "title": "私人漫游",
      "page": "roam"
    },
    {
      "title": "我的音乐",
      "page": "my-music"
    },
    {
      "builtin": "liked"
    },
    {
      "title": "最近播放",
      "page": "recent"
    },
    {
      "title": "我创建的歌单",
      "page": "my-playlists"
    }
  ],
  "settings": [
    {
      "key": "quality",
      "label": "音质",
      "type": "select",
      "default": "",
      "help": "优先使用所选音质，不可用时自动降低",
      "options": [
        {
          "value": "",
          "label": "跟随播放器"
        },
        {
          "value": "standard",
          "label": "标准"
        },
        {
          "value": "high",
          "label": "高音质"
        },
        {
          "value": "lossless",
          "label": "无损"
        },
        {
          "value": "hires",
          "label": "Hi-Res"
        }
      ]
    }
  ]
}
